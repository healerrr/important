generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ImportStatus {
  SUCCESS
  FAILED
}

model Owner {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(50)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  projects  Project[]

  @@map("owners")
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PAUSED
  CANCELLED
}

model Project {
  id           String               @id @default(uuid()) @db.Uuid
  year         Int
  name         String               @db.VarChar(200)
  annualGoal   String               @default("") @map("annual_goal") @db.VarChar(2000)
  departments  String[]             @default([]) @db.VarChar(100)
  status       ProjectStatus        @default(NOT_STARTED)
  progress     Int                  @default(0)
  version      Int                  @default(1)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  owners       Owner[]
  progressLogs ProjectProgressLog[]

  @@unique([year, name], map: "projects_year_name_key")
  @@index([year], map: "projects_year_idx")
  @@index([updatedAt], map: "projects_updated_at_idx")
  @@index([status], map: "projects_status_idx")
  @@map("projects")
}

model ProjectProgressLog {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  oldProgress Int      @map("old_progress")
  newProgress Int      @map("new_progress")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt], map: "project_progress_logs_project_created_idx")
  @@map("project_progress_logs")
}

model ImportBatch {
  id               String       @id @default(uuid()) @db.Uuid
  originalFilename String       @map("original_filename") @db.VarChar(255)
  year             Int
  status           ImportStatus
  totalRows        Int          @default(0) @map("total_rows")
  importedRows     Int          @default(0) @map("imported_rows")
  deletedRows      Int          @default(0) @map("deleted_rows")
  errors           Json?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt], map: "import_batches_created_at_idx")
  @@map("import_batches")
}
