{
  "name": "annual-key-projects-api",
  "version": "1.0.0",
  "private": true,
  "description": "年度重点项目管理系统 RESTful API",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test,prisma,scripts}/**/*.ts\"",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write \"{src,test,prisma,scripts}/**/*.ts\" \"*.{json,md,yml,yaml}\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "prisma db seed",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/throttler": "6.5.0",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "helmet": "8.1.0",
    "joi": "18.0.1",
    "nestjs-pino": "4.6.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.34.0",
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.2.3",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/multer": "2.0.0",
    "@types/node": "24.3.0",
    "@types/supertest": "6.0.3",
    "eslint": "9.34.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "16.3.0",
    "jest": "30.0.5",
    "pino-pretty": "13.1.1",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.1",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0"
  }
}
